# =============================================================================
# Banco de dados
# =============================================================================
# DATABASE_URL e DIRECT_URL sao obrigatorias (o schema.prisma referencia as
# duas): DATABASE_URL e usada pela aplicacao em runtime; DIRECT_URL e usada
# apenas pelo Prisma CLI (migrate/studio). Em um Postgres sem pooler, as duas
# podem apontar para a mesma string.
DATABASE_PROVIDER="postgresql"

# Postgres local (docker-compose na raiz do projeto, ou instalacao local):
DATABASE_URL="postgresql://usuario:senha@localhost:5432/contratos_imobiliarios?schema=public"
DIRECT_URL="postgresql://usuario:senha@localhost:5432/contratos_imobiliarios?schema=public"

# Neon (Postgres serverless): DATABASE_URL = connection string com "-pooler"
# no host (para o runtime da aplicacao, com pgbouncer=true) e DIRECT_URL =
# mesma connection string sem "-pooler" (usada so pelo Prisma para rodar
# migrations). Ambas ficam em Project > Connection Details no console da Neon.
# DATABASE_URL="postgresql://usuario:senha@ep-xxxx-pooler.regiao.aws.neon.tech/neondb?sslmode=require&channel_binding=require&pgbouncer=true"
# DIRECT_URL="postgresql://usuario:senha@ep-xxxx.regiao.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ALTERNATIVA - SQLite, nao exige nenhum servidor instalado. Exige tambem
# trocar o `provider` do datasource em prisma/schema.prisma para "sqlite" e
# remover a linha `directUrl` de la (o SQLite nao usa).
# DATABASE_PROVIDER="sqlite"
# DATABASE_URL="file:./dev.db"

# =============================================================================
# Aplicacao
# =============================================================================
PORT=3333
NODE_ENV="development"

# Segredo usado para assinar o token de sessao (JWT).
# ATENCAO: gere um valor aleatorio longo em producao (minimo 32 caracteres).
JWT_SECRET="troque-este-valor-por-um-segredo-aleatorio-longo"
JWT_EXPIRES_IN="8h"

# Origens liberadas no CORS (separadas por virgula).
CORS_ORIGIN="http://localhost:5173"

# Dias sem mudanca de status a partir dos quais o contrato entra no alerta
# de "contratos parados" do dashboard.
ALERTA_DIAS_PARADO=5
